generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Empreendimento {
  id          String   @id @default(uuid())
  nome        String   @unique
  responsavel String
  municipio   String
  segmento    String
  contato     String
  status      String   @default("ativo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("empreendimentos")
}
